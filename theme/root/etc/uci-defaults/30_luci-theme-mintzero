#!/bin/sh
# uci-defaults script for luci-theme-mintzero
# Registers the theme in luci.themes and activates it on fresh installs.
# Idempotent: only sets values that are missing; upgrades keep user config.

changed=0

set_opt() {
	local key=$1
	local val=$2

	if ! uci -q get "luci.$key" 2>/dev/null; then
		uci set "luci.$key=$val"
		changed=1
	fi
}

set_opt themes.mintzero /luci-static/mintzero
set_opt themes.mintzero-light /luci-static/mintzero
set_opt themes.mintzero-dark /luci-static/mintzero

# Wallpaper defaults for the mintzero UCI section. Only written when the
# section does not exist yet, so user overrides survive upgrades.
if ! uci -q get mintzero.wallpaper 2>/dev/null; then
	uci -q set mintzero.wallpaper=wallpaper 2>/dev/null || {
		[ -f /etc/config/mintzero ] || touch /etc/config/mintzero
		uci set mintzero.wallpaper=wallpaper
	}
	uci -q set mintzero.wallpaper.enabled=1
	uci -q set mintzero.wallpaper.market=zh-CN
	uci -q set mintzero.wallpaper.cache_ttl=86400
	uci -q set mintzero.wallpaper.overlay=0.45
	uci -q set mintzero.wallpaper.blur=0
	uci -q set mintzero.wallpaper.random=1
	changed=1
fi

if [ "$PKG_UPGRADE" != 1 ] && [ $changed = 1 ]; then
	set_opt main.mediaurlbase /luci-static/mintzero
fi

if [ $changed = 1 ]; then
	uci commit luci
	uci commit mintzero
fi

exit 0
