#!/bin/sh
# uci-defaults script for luci-theme-mintzero
# Registers the theme variants in luci.themes and activates the theme on
# fresh installs. The theme keys are package-owned and rewritten on every
# install/upgrade; the user's active theme (luci.main.mediaurlbase) is
# only touched on fresh installs.

# Each variant gets its own mediaurlbase so that the LuCI theme selector
# can switch between them: header/footer/sysauth templates are looked up
# under themes/$(basename mediaurlbase)/, and htdocs/luci-static/ plus
# ucode/template/themes/ provide mintzero-light / mintzero-dark symlinks
# pointing to the mintzero originals.
# NOTE: UCI option names may only contain [a-zA-Z0-9_]; hyphens (e.g.
# "mintzero-light") make uci set fail with uci: Parse error, so the
# registered keys use CamelCase while the mediaurlbase values keep the
# hyphenated symlink paths.
uci set luci.themes.mintzero=/luci-static/mintzero
uci set luci.themes.MintzeroLight=/luci-static/mintzero-light
uci set luci.themes.MintzeroDark=/luci-static/mintzero-dark

# Wallpaper defaults for the mintzero UCI section. Only written when the
# section does not exist yet, so user config survives upgrades.
if ! uci -q get mintzero.wallpaper 2>/dev/null; then
	uci -q set mintzero.wallpaper=wallpaper 2>/dev/null || {
		[ -f /etc/config/mintzero ] || touch /etc/config/mintzero
		uci set mintzero.wallpaper=wallpaper
	}
	uci -q set mintzero.wallpaper.enabled=1
	uci -q set mintzero.wallpaper.market=zh-CN
	uci -q set mintzero.wallpaper.cache_ttl=86400
	uci -q set mintzero.wallpaper.overlay=0.45
	uci -q set mintzero.wallpaper.blur=0
	uci -q set mintzero.wallpaper.random=1
fi

if [ "$PKG_UPGRADE" != 1 ]; then
	uci -q set luci.main.mediaurlbase=/luci-static/mintzero
fi

uci commit luci
uci commit mintzero

exit 0
