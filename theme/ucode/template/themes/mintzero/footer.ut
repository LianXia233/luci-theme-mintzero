		{% if (!blank_page): %}
			</main>
		</div>

		<footer class="mz-footer">
			<span>
				Powered by
				<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">
					{{ version.luciname }} ({{ version.luciversion }})</a>
				/
				<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">
					{{ version.distname }} {{ version.distversion }} ({{ version.distrevision }})</a>
				<span class="mz-footer-sep">|</span>
				<a href="https://github.com/LianXia233/luci-theme-mintzero" target="_blank" rel="noreferrer" class="mz-footer-brand">mintzero</a>
			</span>
		</footer>
		<script>L.require('menu-mintzero')</script>
		<script>
(function () {
  'use strict';

  /* ==== Collapsible menu groups ==== */
  function initMenu() {
    /* Remove top-level wrapper (管理权), promote child groups to mainmenu */
    var topLi = document.querySelector('#mainmenu > li');
    if (topLi) {
      var topUl = topLi.querySelector(':scope > ul');
      if (topUl) {
        while (topUl.firstChild) topLi.parentNode.insertBefore(topUl.firstChild, topLi);
      }
      topLi.parentNode.removeChild(topLi);
    }
    var groups = document.querySelectorAll('#mainmenu > li');
    groups.forEach(function (li) {
      var sub = li.querySelector(':scope > ul');
      if (!sub) return;
      li.classList.add('mz-menu-group');
      var a = li.querySelector(':scope > a');
      if (!a) return;
      var label = a.textContent.trim();

      // Determine default state: expand group containing active page, collapse others.
      var hasActive = sub.querySelector('.active, li.active > a, a.active') !== null;
      var stored = null;
      try { stored = localStorage.getItem('mz-nav-' + label); } catch (err) {}
      var collapsed;
      if (stored !== null) {
        collapsed = stored === '1';
      } else {
        collapsed = !hasActive;
      }
      if (collapsed) {
        li.classList.add('mz-collapsed');
        sub.style.display = 'none';
      }

      a.addEventListener('click', function (e) {
        e.preventDefault();
        var nowCollapsed = li.classList.toggle('mz-collapsed');
        sub.style.display = nowCollapsed ? 'none' : '';
        try { localStorage.setItem('mz-nav-' + label, nowCollapsed ? '1' : '0'); } catch (err) {}
      });
    });
    // FOUC fix: show menu only after folding is done
    var mm = document.getElementById('mainmenu');
    if (mm) mm.classList.add('mz-menu-ready');
  }

  /* ==== Overview page: circular gauges + info cards ==== */
  function initOverview() {
    if (document.body.getAttribute('data-page') !== 'admin-status-overview') return;
    if (document.querySelector('.mz-overview-panel')) return;

    var tables = document.querySelectorAll('#mz-view table.table');
    if (tables.length < 3) return;

    var t0 = tables[0].innerText;
    function grab(re) { var m = t0.match(re); return m ? m[1].trim() : ''; }

    var cpu = grab(/CPU\s*使用率[（(]?\s*%?[）)]?\s*(\d+)/) || '0';
    var temp = grab(/温度\s*CPU:\s*([\d.]+)/) || '';
    var hostname = grab(/主机名\s*([^\n]+)/) || '';
    var uptime = grab(/运行时间\s*([^\n]+)/) || '';
    var load = grab(/平均负载\s*([^\n]+)/) || '';
    var model = grab(/型号\s*([^\n]+)/) || '';

    function parseBar(tableIdx) {
      var bars = tables[tableIdx].querySelectorAll('.cbi-progressbar[title]');
      if (!bars.length) return null;
      var m = bars[0].getAttribute('title').match(/([\d.]+)\s*([A-Za-z]+)\s*\/\s*([\d.]+)\s*([A-Za-z]+)\s*\((\d+)%\)/);
      if (!m) return null;
      return { used: m[1], usedUnit: m[2], total: m[3], totalUnit: m[4], pct: parseInt(m[5], 10) };
    }

    var mem = parseBar(1) || { used: '0', usedUnit: 'MiB', total: '0', totalUnit: 'MiB', pct: 0 };
    var storage = parseBar(2) || { used: '0', usedUnit: 'MiB', total: '0', totalUnit: 'MiB', pct: 0 };

    var memDetails = [];
    tables[1].querySelectorAll('tr').forEach(function (row) {
      var cells = row.querySelectorAll('td');
      if (cells.length >= 2) {
        var label = cells[0].textContent.trim();
        var bar = cells[1].querySelector('.cbi-progressbar[title]');
        var val = '';
        if (bar) {
          var m = bar.getAttribute('title').match(/([\d.]+\s*[A-Za-z]+)/);
          if (m) val = m[1];
        } else {
          val = cells[1].textContent.trim();
        }
        if (label && val) memDetails.push({ label: label, value: val });
      }
    });

    var tempInfo = '';
    tables[2].querySelectorAll('tr').forEach(function (row) {
      if (row.textContent.indexOf('临时') >= 0) {
        var bar = row.querySelector('.cbi-progressbar[title]');
        if (bar) tempInfo = bar.getAttribute('title').replace(/\s*\(.*\)/, '');
      }
    });

    var CIRC = 2 * Math.PI * 52;
    function ring(pct, cls) {
      var offset = CIRC * (1 - pct / 100);
      return '<svg class="mz-ring" viewBox="0 0 120 120" aria-hidden="true">' +
        '<circle class="mz-ring-bg" cx="60" cy="60" r="52"></circle>' +
        '<circle class="mz-ring-fg ' + cls + '" cx="60" cy="60" r="52" stroke-dasharray="' + CIRC + '" stroke-dashoffset="' + offset + '"></circle>' +
        '<text class="mz-ring-text" x="60" y="67" text-anchor="middle">' + pct + '%</text>' +
        '</svg>';
    }

    var panel = document.createElement('div');
    panel.className = 'mz-overview-panel';
    panel.innerHTML =
      '<div class="mz-info-cards">' +
        '<div class="mz-info-card"><div class="mz-info-label">设备</div><div class="mz-info-value">' + hostname + '</div></div>' +
        '<div class="mz-info-card"><div class="mz-info-label">运行时间</div><div class="mz-info-value">' + uptime + '</div></div>' +
        '<div class="mz-info-card"><div class="mz-info-label">平均负载</div><div class="mz-info-value">' + load + '</div></div>' +
        '<div class="mz-info-card"><div class="mz-info-label">型号</div><div class="mz-info-value">' + model + '</div></div>' +
      '</div>' +
      '<div class="mz-rings">' +
        '<div class="mz-ring-card">' + ring(parseInt(cpu, 10), 'mz-ring-cpu') +
          '<div class="mz-ring-info"><div class="mz-ring-title">CPU</div>' +
          (temp ? '<div class="mz-ring-sub">温度 ' + temp + '°C</div>' : '') + '</div></div>' +
        '<div class="mz-ring-card">' + ring(mem.pct, 'mz-ring-mem') +
          '<div class="mz-ring-info"><div class="mz-ring-title">内存</div>' +
          '<div class="mz-ring-pct">' + mem.used + ' / ' + mem.total + ' ' + mem.totalUnit + '</div>' +
          '<div class="mz-mem-detail">' + memDetails.map(function (d) { return '<span>' + d.label + ' ' + d.value + '</span>'; }).join('') + '</div>' +
          '</div></div>' +
        '<div class="mz-ring-card">' + ring(storage.pct, 'mz-ring-storage') +
          '<div class="mz-ring-info"><div class="mz-ring-title">存储</div>' +
          '<div class="mz-ring-pct">' + storage.used + ' / ' + storage.total + ' ' + storage.totalUnit + '</div>' +
          (tempInfo ? '<div class="mz-ring-sub">临时 ' + tempInfo + '</div>' : '') + '</div></div>' +
      '</div>';

    var view = document.getElementById('mz-view');
    if (!view) return;
    view.insertBefore(panel, view.firstChild);

    /* ==== Port status cards (aurora-style grid) ==== */
    var portSection = null;
    document.querySelectorAll('#mz-view .cbi-section').forEach(function (sec) {
      var h = sec.querySelector('h2, h3');
      if (h && h.textContent.trim().indexOf('端口状态') === 0) portSection = sec;
    });
    var portPanel = null;
    if (portSection) {
      var portCards = [];
      portSection.querySelectorAll('.ifacebox').forEach(function (box) {
        var heads = box.querySelectorAll('.ifacebox-head');
        var bodies = box.querySelectorAll('.ifacebox-body');
        var name = heads[0] ? heads[0].textContent.trim() : '';
        var statusText = bodies[0] ? bodies[0].textContent.trim() : '';
        var isUp = statusText.indexOf('未连接') < 0 && statusText.length > 0;
        var speed = isUp ? statusText : '未连接';
        var tx = '', rx = '';
        if (bodies[1]) {
          var t = bodies[1].innerText;
          var txm = t.match(/\u25b2\s*([\d.]+\s*[A-Za-z]+)/);
          var rxm = t.match(/\u25bc\s*([\d.]+\s*[A-Za-z]+)/);
          if (txm) tx = txm[1].trim();
          if (rxm) rx = rxm[1].trim();
        }
        var zones = [];
        box.querySelectorAll('.ifacebadge').forEach(function (b) {
          var zt = b.textContent.trim().replace(/\s+/g, ' ');
          if (zt) { zt = zt.replace(/:\s*$/, '').trim(); if (zt && zones.indexOf(zt) < 0) zones.push(zt); }
        });
        portCards.push({name: name, speed: speed, isUp: isUp, tx: tx, rx: rx, zones: zones});
      });
      if (portCards.length > 0) {
        portPanel = document.createElement('div');
        portPanel.className = 'mz-port-panel';
        portPanel.innerHTML = '<h3 class="mz-section-title">端口状态</h3>' +
          '<div class="mz-port-grid">' +
          portCards.map(function (p) {
            return '<div class="mz-port-card' + (p.isUp ? ' up' : ' down') + '">' +
              '<div class="mz-port-name">' + p.name + '</div>' +
              '<div class="mz-port-status">' + (p.isUp ? '<span class="mz-port-dot up"></span>' : '<span class="mz-port-dot down"></span>') + ' ' + p.speed + '</div>' +
              (p.zones.length > 0 ? '<div class="mz-port-zones">' + p.zones.join(', ') + '</div>' : '') +
              ((p.tx || p.rx) ? '<div class="mz-port-traffic">' +
                (p.tx ? '<span class="mz-tx">▲ ' + p.tx + '</span>' : '') +
                (p.rx ? '<span class="mz-rx">▼ ' + p.rx + '</span>' : '') +
                '</div>' : '') +
              '</div>';
          }).join('') +
          '</div>';
        view.insertBefore(portPanel, panel.nextSibling);
      }
    }

    /* ==== Network upstream cards (aurora-style) ==== */
    var netSection = null;
    document.querySelectorAll('#mz-view .cbi-section').forEach(function (sec) {
      var h = sec.querySelector('h2, h3');
      if (h && h.textContent.trim().indexOf('网络') === 0) netSection = sec;
    });
    if (netSection) {
      var netCards = [];
      netSection.querySelectorAll('.ifacebox').forEach(function (box) {
        var head = box.querySelector('.ifacebox-head');
        var title = head ? head.textContent.trim() : '';
        var body = box.querySelector('.ifacebox-body');
        var items = [];
        var deviceInfo = '';
        if (body) {
          body.querySelectorAll('.nowrap').forEach(function (nw) {
            var strong = nw.querySelector('strong');
            var label = strong ? strong.textContent.trim() : '';
            var value = nw.textContent.replace(label, '').trim();
            if (label && value && label.indexOf('DHCPv6') < 0 && label.indexOf('设备') < 0 && label.indexOf('MAC') < 0) items.push({label: label, value: value});
          });
          var devBadge = body.querySelector('.ifacebadge');
          if (devBadge) deviceInfo = devBadge.textContent.trim().replace(/\s+/g, ' ');
        }
        netCards.push({title: title, items: items, device: deviceInfo});
      });
      if (netCards.length > 0) {
        var netPanel = document.createElement('div');
        netPanel.className = 'mz-net-panel';
        netPanel.innerHTML = '<h3 class="mz-section-title">网络</h3>' +
          '<div class="mz-net-grid">' +
          netCards.map(function (n) {
            return '<div class="mz-net-card">' +
              '<div class="mz-net-header">' + n.title + '</div>' +
              '<div class="mz-net-body">' +
              n.items.map(function (it) {
                return '<div class="mz-net-row"><span class="mz-net-label">' + it.label + '</span><span class="mz-net-value">' + it.value + '</span></div>';
              }).join('') +
              (n.device ? '<div class="mz-net-device">' + n.device + '</div>' : '') +
              '</div></div>';
          }).join('') +
          '</div>';
        var refNode = portPanel || panel;
        view.insertBefore(netPanel, refNode.nextSibling);
      }
    }

    /* ==== System detail card ==== */
    var sysSection = null;
    document.querySelectorAll('#mz-view .cbi-section').forEach(function (sec) {
      var h = sec.querySelector('h2, h3');
      if (h && h.textContent.trim().indexOf('系统') === 0 && h.textContent.trim().indexOf('端口') < 0) sysSection = sec;
    });
    if (sysSection) {
      var sysItems = [];
      sysSection.querySelectorAll('table tr').forEach(function (row) {
        var cells = row.querySelectorAll('td');
        if (cells.length >= 2) {
          var label = cells[0].textContent.trim();
          var value = cells[1].textContent.trim();
          if (label && value && label !== '?') sysItems.push({label: label, value: value});
        }
      });
      if (sysItems.length > 0) {
        var sysPanel = document.createElement('div');
        sysPanel.className = 'mz-sys-panel';
        sysPanel.innerHTML = '<h3 class="mz-section-title">系统信息</h3>' +
          '<div class="mz-sys-grid">' +
          sysItems.map(function (it) {
            return '<div class="mz-sys-item"><span class="mz-sys-label">' + it.label + '</span><span class="mz-sys-value">' + it.value + '</span></div>';
          }).join('') +
          '</div>';
        var refNode = netPanel || portPanel || panel;
        view.insertBefore(sysPanel, refNode.nextSibling);
      }
    }

    /* ==== DHCP leases card ==== */
    var dhcpSection = null;
    document.querySelectorAll('#mz-view .cbi-section').forEach(function (sec) {
      var h = sec.querySelector('h2, h3');
      if (h && h.textContent.trim().indexOf('DHCP') === 0) dhcpSection = sec;
    });
    if (dhcpSection) {
      var dhcpTables = dhcpSection.querySelectorAll('table');
      var dhcpHtml = '<h3 class="mz-section-title">DHCP 租约</h3>';
      dhcpTables.forEach(function (t, ti) {
        var rows = t.querySelectorAll('tr');
        if (rows.length <= 1) {
          dhcpHtml += '<div class="mz-empty-state">' + (ti === 0 ? '暂无 IPv4 租约' : '暂无 IPv6 租约') + '</div>';
          return;
        }
        dhcpHtml += '<div class="mz-table-card"><table class="mz-data-table"><thead><tr>';
        rows[0].querySelectorAll('th').forEach(function (th, ci) {
          if (ci < 5) dhcpHtml += '<th>' + th.textContent.trim() + '</th>';
        });
        dhcpHtml += '</tr></thead><tbody>';
        for (var ri = 1; ri < rows.length; ri++) {
          var cells = rows[ri].querySelectorAll('td');
          if (cells.length < 2) continue;
          dhcpHtml += '<tr>';
          for (var ci = 0; ci < Math.min(cells.length, 5); ci++) {
            dhcpHtml += '<td>' + cells[ci].textContent.trim() + '</td>';
          }
          dhcpHtml += '</tr>';
        }
        dhcpHtml += '</tbody></table></div>';
      });
      var dhcpPanel = document.createElement('div');
      dhcpPanel.className = 'mz-dhcp-panel';
      dhcpPanel.innerHTML = dhcpHtml;
      var refNode2 = sysPanel || netPanel || portPanel || panel;
      view.insertBefore(dhcpPanel, refNode2.nextSibling);
    }

    /* ==== WiFi card ==== */
    var wifiSection = null;
    document.querySelectorAll('#mz-view .cbi-section').forEach(function (sec) {
      var h = sec.querySelector('h2, h3');
      if (h && h.textContent.trim().indexOf('无线') === 0) wifiSection = sec;
    });
    if (wifiSection) {
      var wifiRadios = [];
      wifiSection.querySelectorAll('.ifacebox').forEach(function (box) {
        var name = box.querySelector('.ifacebox-head') ? box.querySelector('.ifacebox-head').textContent.trim() : '';
        var body = box.querySelector('.ifacebox-body');
        var info = {};
        if (body) {
          body.querySelectorAll('.nowrap').forEach(function (nw) {
            var strong = nw.querySelector('strong');
            var label = strong ? strong.textContent.trim().replace(/:$/, '') : '';
            var value = nw.textContent.replace(strong ? strong.textContent : '', '').trim();
            if (label) info[label] = value;
          });
        }
        wifiRadios.push({name: name, info: info});
      });
      var wifiHtml = '<h3 class="mz-section-title">无线</h3><div class="mz-wifi-radios">';
      wifiRadios.forEach(function (r) {
        wifiHtml += '<div class="mz-wifi-card">' +
          '<div class="mz-wifi-name">' + (r.info['SSID'] || r.name) + '</div>' +
          '<div class="mz-wifi-sub">' + r.name + ' · ' + (r.info['信道'] || '') + ' · ' + (r.info['速率'] || '') + '</div>' +
          '<div class="mz-wifi-stats">' +
          '<span><strong>' + (r.info['关联数'] || '0') + '</strong> 已连接</span>' +
          '<span><strong>' + (r.info['加密'] ? r.info['加密'].substring(0, 15) : '-') + '</strong></span>' +
          '</div></div>';
      });
      wifiHtml += '</div>';
      // 已连接站点表格
      var wifiTable = wifiSection.querySelector('table');
      if (wifiTable) {
        var rows = wifiTable.querySelectorAll('tr');
        if (rows.length > 1) {
          wifiHtml += '<h4 class="mz-subtitle">已连接站点</h4><div class="mz-table-card"><table class="mz-data-table"><thead><tr>';
          var headers = rows[0].querySelectorAll('th');
          for (var hi = 0; hi < Math.min(headers.length, 5); hi++) {
            wifiHtml += '<th>' + headers[hi].textContent.trim().substring(0, 12) + '</th>';
          }
          wifiHtml += '</tr></thead><tbody>';
          for (var ri = 1; ri < rows.length; ri++) {
            var cells = rows[ri].querySelectorAll('td');
            if (cells.length < 2) continue;
            wifiHtml += '<tr>';
            for (var ci = 0; ci < Math.min(cells.length, 5); ci++) {
              wifiHtml += '<td>' + cells[ci].textContent.trim().substring(0, 25) + '</td>';
            }
            wifiHtml += '</tr>';
          }
          wifiHtml += '</tbody></table></div>';
        }
      }
      var wifiPanel = document.createElement('div');
      wifiPanel.className = 'mz-wifi-panel';
      wifiPanel.innerHTML = wifiHtml;
      var refNode3 = dhcpPanel || sysPanel || netPanel || portPanel || panel;
      view.insertBefore(wifiPanel, refNode3.nextSibling);
    }

    /* ==== UPnP port mapping card ==== */
    var upnpSection = null;
    document.querySelectorAll('#mz-view .cbi-section').forEach(function (sec) {
      var h = sec.querySelector('h2, h3');
      if (h && (h.textContent.trim().indexOf('UPnP') >= 0 || h.textContent.trim().indexOf('端口映射') >= 0)) upnpSection = sec;
    });
    if (upnpSection) {
      var upnpTable = upnpSection.querySelector('table');
      var upnpHtml = '<h3 class="mz-section-title">UPnP 端口映射</h3>';
      if (upnpTable) {
        var rows = upnpTable.querySelectorAll('tr');
        if (rows.length <= 1 || (rows.length === 2 && rows[1].textContent.indexOf('没有') >= 0)) {
          upnpHtml += '<div class="mz-empty-state">当前没有生效的端口映射</div>';
        } else {
          upnpHtml += '<div class="mz-table-card"><table class="mz-data-table"><thead><tr>';
          rows[0].querySelectorAll('th').forEach(function (th, ci) {
            if (ci < 6) upnpHtml += '<th>' + th.textContent.trim().substring(0, 10) + '</th>';
          });
          upnpHtml += '</tr></thead><tbody>';
          for (var ri = 1; ri < rows.length; ri++) {
            var cells = rows[ri].querySelectorAll('td');
            if (cells.length < 2) continue;
            upnpHtml += '<tr>';
            for (var ci = 0; ci < Math.min(cells.length, 6); ci++) {
              upnpHtml += '<td>' + cells[ci].textContent.trim() + '</td>';
            }
            upnpHtml += '</tr>';
          }
          upnpHtml += '</tbody></table></div>';
        }
      } else {
        upnpHtml += '<div class="mz-empty-state">当前没有生效的端口映射</div>';
      }
      var upnpPanel = document.createElement('div');
      upnpPanel.className = 'mz-upnp-panel';
      upnpPanel.innerHTML = upnpHtml;
      var refNode4 = wifiPanel || dhcpPanel || sysPanel || netPanel || portPanel || panel;
      view.insertBefore(upnpPanel, refNode4.nextSibling);
    }

    // Persistently hide original sections (LuCI re-renders on refresh).
    var hideAttempts = 0;
    var hideTimer = setInterval(function () {
      hideAttempts++;
      document.querySelectorAll('#mz-view .cbi-section').forEach(function (sec) {
        var h = sec.querySelector('h2, h3, .cbi-section-title');
        if (h) {
          var txt = h.textContent.trim();
          if ((txt.indexOf('内存') === 0 || txt.indexOf('存储') === 0 || txt.indexOf('端口状态') === 0 || txt.indexOf('网络') === 0 || txt.indexOf('系统') === 0 || txt.indexOf('DHCP') === 0 || txt.indexOf('无线') === 0 || txt.indexOf('UPnP') >= 0 || txt.indexOf('端口映射') >= 0 || txt.indexOf('DSL') === 0) && !sec.classList.contains('mz-hidden-section')) {
            sec.classList.add('mz-hidden-section');
          }
        }
      });
      if (hideAttempts > 120) clearInterval(hideTimer);
    }, 500);
  }

  /* ==== Boot: wait for LuCI async render ==== */
  var menuDone = false;
  var overviewDone = false;

  function tryInitMenu() {
    if (menuDone) return;
    var mm = document.getElementById('mainmenu');
    if (mm && mm.children.length > 0) {
      menuDone = true;
      try { initMenu(); } catch (err) {}
    }
  }

  function tryInitOverview() {
    if (overviewDone) return;
    if (document.body.getAttribute('data-page') !== 'admin-status-overview') {
      overviewDone = true;
      return;
    }
    var tables = document.querySelectorAll('#mz-view table.table');
    if (tables.length >= 3) {
      overviewDone = true;
      try { initOverview(); } catch (err) {}
    }
  }

  function boot() {
    tryInitMenu();
    tryInitOverview();
    if (menuDone && overviewDone) return;
    var observer = new MutationObserver(function () {
      tryInitMenu();
      tryInitOverview();
      if (menuDone && overviewDone) observer.disconnect();
    });
    var mm = document.getElementById('mainmenu');
    var view = document.getElementById('mz-view');
    if (mm) observer.observe(mm, { childList: true, subtree: true });
    if (view) observer.observe(view, { childList: true, subtree: true });
    setTimeout(function () { observer.disconnect(); }, 20000);
  }

  setTimeout(boot, 800);
})();
		</script>
		{% endif %}
	</body>
</html>
